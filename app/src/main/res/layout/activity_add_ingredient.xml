<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#800000"
    android:padding="16dp"
    tools:context=".AddIngredientActivity">

    <EditText
        android:id="@+id/editIngredient"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="109dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="582dp"
        android:textSize="16dp"
        android:ems="10"
        android:hint="Ingredient Name"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="69dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="622dp"
        android:text="Ingredient Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="165dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="526dp"
        android:text="Quantity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="205dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="486dp"
        android:textSize="16dp"
        android:ems="10"
        android:hint="Quantity"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.05" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="267dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="424dp"
        android:text="Unit Of Measure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="371dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="320dp"
        android:text="Expiry Date"
        android:hint="YYYY-MM-DD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/editUnitMeasure"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="307dp"
        android:layout_marginEnd="137dp"
        android:textSize="16dp"
        android:layout_marginBottom="384dp"
        android:ems="10"
        android:hint="Unit Measure(g,kg,ml,etc)"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/editExpireDate"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="412dp"
        android:layout_marginEnd="137dp"
        android:layout_marginBottom="279dp"
        android:textSize="16dp"
        android:ems="10"
        android:hint="Expire Date"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="607dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="76dp"
        android:text="SAVE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.406" />
</androidx.constraintlayout.widget.ConstraintLayout>